<mxfile host="app.diagrams.net" agent="nexus-architect" version="24.0.0">
  <diagram name="Transactional Outbox" id="outbox"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="Transactional Outbox — the event commits with the business write (ADR-0006)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
    </mxCell>
    <mxCell id="req" value="Request / Command&#10;(register user · create order · process payment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="40" y="300" width="180" height="80" as="geometry" />
    </mxCell>
    <mxCell id="tx" value="Business service — @Transactional&#10;single DB transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="180" width="330" height="320" as="geometry" />
    </mxCell>
    <mxCell id="w1" value="1 · Business write&#10;INSERT user / order / payment row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="tx">
      <mxGeometry x="30" y="60" width="270" height="70" as="geometry" />
    </mxCell>
    <mxCell id="w2" value="2 · INSERT outbox row — PENDING&#10;same transaction, same connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;fontStyle=1;" vertex="1" parent="tx">
      <mxGeometry x="30" y="160" width="270" height="70" as="geometry" />
    </mxCell>
    <mxCell id="commit" value="COMMIT — atomic&#10;both rows survive together&#10;or neither does" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="tx">
      <mxGeometry x="30" y="260" width="270" height="40" as="geometry" />
    </mxCell>
    <mxCell id="relay" value="Outbox relay&#10;poll PENDING rows (500 ms)&#10;exponential backoff 1s → 5m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="180" width="200" height="110" as="geometry" />
    </mxCell>
    <mxCell id="kafka" value="Kafka topic&#10;user-events · order.events · payment.events" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1060" y="190" width="220" height="90" as="geometry" />
    </mxCell>
    <mxCell id="pub" value="mark PUBLISHED&#10;+ published_at — only after broker ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="330" width="200" height="70" as="geometry" />
    </mxCell>
    <mxCell id="fail" value="attempts ≥ 5 → FAILED&#10;DLQ · payment reconciles hourly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="440" width="200" height="70" as="geometry" />
    </mxCell>
    <mxCell id="note" value="Live in auth-service (user_outbox → user-events) and ms-payment-service (payment_outbox → payment.events).&#10;No dual-write gap: a failed Keycloak call / publish rolls back the local write with the row." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="40" y="620" width="1200" height="50" as="geometry" />
    </mxCell>
    <mxCell id="e1" edge="1" parent="1" source="req" target="tx" value="enter TX" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e2" edge="1" parent="1" source="tx" target="relay" value="PENDING rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.3;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e3" edge="1" parent="1" source="relay" target="kafka" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.4;entryX=0;entryY=0.5;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e4" edge="1" parent="1" source="kafka" target="pub" value="on ack" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e5" edge="1" parent="1" source="relay" target="fail" value="on max attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
  </root>
  </mxGraphModel></diagram>
</mxfile>
