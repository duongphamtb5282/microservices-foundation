        <mxCell id="hOutboxP" value="Payment Outbox&#10;Relay" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="34" width="140" height="36" as="geometry" />
