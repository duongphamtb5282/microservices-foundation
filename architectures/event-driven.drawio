    </mxCell>
    <mxCell id="custc" value="ms-customer · WebFlux&#10;UserEventConsumer — dedup on email&#10;self-provisions the customer profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1040" y="140" width="260" height="90" as="geometry" />
    </mxCell>
