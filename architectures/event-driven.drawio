      <mxGeometry x="40" y="390" width="240" height="90" as="geometry" />
    </mxCell>
    <mxCell id="kafka" value="Apache Kafka (KRaft)&#10;user-events · order.events · payment.events&#10;+ &lt;topic&gt;.dlq for poison payloads" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
