<mxfile host="app.diagrams.net" agent="nexus-architect" version="24.0.0">
  <diagram name="Event-Driven Backbone" id="event-driven"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="Event-Driven Backbone — Kafka (KRaft) · outbox producers · idempotent consumers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
