    <mxCell id="saga" value="Choreographed saga across the backbone:&#10;order.events → payment upsert (idempotent) → payment.events → order settle&#10;compensation: ORDER_CANCELLED → refund/cancel (missing payment = no-op)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
