# Copy Spring @Qualifier from fields onto generated constructor parameters.
# Without this, @RequiredArgsConstructor drops the field qualifier, so constructor
# injection of e.g. Executor beans falls back to by-type resolution and fails
# ("required a single bean, but N were found") whenever several candidates exist
# (coreAsyncExecutor, outboxPublisherExecutor, taskScheduler, ...).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
